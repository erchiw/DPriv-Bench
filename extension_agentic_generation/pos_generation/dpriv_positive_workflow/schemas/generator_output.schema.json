{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DPrivBench positive generator output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "source_manifest_sha256",
    "candidates"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "source_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "candidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/candidate"
      }
    }
  },
  "$defs": {
    "nullableString": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "locator",
        "quote",
        "supports"
      ],
      "properties": {
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "quote": {
          "type": "string",
          "minLength": 1
        },
        "supports": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "source_id",
        "question_tex",
        "label",
        "expected_answer",
        "proof",
        "assumptions",
        "source_evidence",
        "citation",
        "pdf_link",
        "publish_year",
        "section_number",
        "subject",
        "topic",
        "generator_checks"
      ],
      "properties": {
        "candidate_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "question_tex": {
          "type": "string",
          "minLength": 20
        },
        "label": {
          "const": 1
        },
        "expected_answer": {
          "const": "yes"
        },
        "proof": {
          "type": "string",
          "minLength": 20
        },
        "assumptions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "source_evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "citation": {
          "$ref": "#/$defs/nullableString"
        },
        "pdf_link": {
          "$ref": "#/$defs/nullableString"
        },
        "publish_year": {
          "$ref": "#/$defs/nullableString"
        },
        "section_number": {
          "$ref": "#/$defs/nullableString"
        },
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "topic": {
          "type": "string",
          "minLength": 1
        },
        "generator_checks": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "all_symbols_defined",
            "adjacency_explicit_or_irrelevant",
            "parameter_domains_preserved",
            "claim_matches_source",
            "proof_is_self_contained"
          ],
          "properties": {
            "all_symbols_defined": {
              "type": "boolean"
            },
            "adjacency_explicit_or_irrelevant": {
              "type": "boolean"
            },
            "parameter_domains_preserved": {
              "type": "boolean"
            },
            "claim_matches_source": {
              "type": "boolean"
            },
            "proof_is_self_contained": {
              "type": "boolean"
            }
          }
        }
      }
    }
  }
}

